@startuml
left to right direction
skinparam packageStyle rectangle
title GPE — Cas d’utilisation du MVP et évolutions

actor "Administrateur actif" as ADMIN
actor "Agent" as AGENT
actor "Utilisateur non connecté" as VISITOR

rectangle "GPE — fonctions disponibles" {
  usecase "Se connecter /\nse déconnecter" as AUTH
  usecase "Consulter le tableau de bord" as DASH
  usecase "Consulter / gérer\nles biens" as ASSET
  usecase "Gérer les sites" as SITE
  usecase "Gérer les comptes\n(rôle, statut)" as USERS
  usecase "Consulter / marquer\nles notifications" as NOTIF
  usecase "Consulter / imprimer\nles rapports globaux" as REPORT
}

rectangle "Évolutions prévues — non livrées" {
  usecase "Affecter / transférer un bien" as ASSIGN
  usecase "Conduire une campagne\nd’inventaire physique" as INVENTORY
  usecase "Joindre des pièces\njustificatives" as DOCS
  usecase "Consulter l’audit\net les historiques" as AUDIT
}

VISITOR --> AUTH
ADMIN --> AUTH
ADMIN --> DASH
ADMIN --> ASSET
ADMIN --> SITE
ADMIN --> USERS
ADMIN --> NOTIF
ADMIN --> REPORT
AGENT ..> ASSET : accès agent à définir
AGENT ..> SITE : politique à définir

ADMIN ..> ASSIGN : évolution
ADMIN ..> INVENTORY : évolution
ADMIN ..> DOCS : évolution
ADMIN ..> AUDIT : évolution
note bottom of AGENT
Les routes biens et sites ne sont pas
toutes protégées dans ce MVP.
Ne pas exposer en production.
end note
@enduml
